{
  "effortLevel": "medium",
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.production)",
      "Read(./**/.env.*.local)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Edit(./**/.env.*.local)",
      "Write(./**/.env)",
      "Write(./**/.env.local)",
      "Write(./**/.env.*.local)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "Bash(rm -rf*)",
      "Bash(*--no-verify*)"
    ]
  },
  "hooks": {
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "for p in python3 python py; do if \"$p\" -c \"import sys\" >/dev/null 2>&1; then PYTHONUTF8=1 exec \"$p\" \"$CLAUDE_PROJECT_DIR/scripts/collect-mistake.py\"; fi; done; exit 0"
          }
        ]
      }
    ]
  }
}
