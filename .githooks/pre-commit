#!/bin/sh
# 秘密情報がコミットに入るのを止める（事故防止・層2）。
# 有効化: git config core.hooksPath .githooks

files=$(git diff --cached --name-only --diff-filter=ACM)
[ -z "$files" ] && exit 0

# 1) .env 系ファイルそのもの（.env.example は除く）
bad=$(echo "$files" | grep -E '(^|/)\.env(\..*)?$' | grep -v '\.env\.example$')
if [ -n "$bad" ]; then
  echo "[pre-commit] .env ファイルはコミットできません:"
  echo "$bad"
  echo "  → git restore --staged <ファイル> で外してください"
  exit 1
fi

# 2) キーらしき文字列（Supabase の JWT、OpenAI/Anthropic 形式、Postgres 接続文字列）
pattern='eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|postgres(ql)?://[^ ]+:[^ ]+@'
hit=$(git diff --cached -U0 -- $files | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -E "$pattern")
if [ -n "$hit" ]; then
  echo "[pre-commit] API キーや接続文字列らしき行が含まれています:"
  echo "$hit" | cut -c1-120
  echo "  → 値を消して、環境変数（.env / Vercel / Render）に移してください"
  exit 1
fi
# 3) 仕様の表に M-/SP- の行が増えたのに、図・モックを一緒に更新していないときの警告（止めない）
staged=$(git -c core.quotepath=false diff --cached --name-only)
for spec in $(echo "$staged" | grep -E '^02_プロジェクト/[^/]+/仕様\.md$'); do
  proj=${spec%/仕様.md}
  added=$(git -c core.quotepath=false diff --cached -U0 -- "$spec" | grep -E '^\+\| *(M|SP)-[0-9]')
  [ -z "$added" ] && continue
  if ! echo "$staged" | grep -q "^$proj/evidence/mock/"; then
    echo "[pre-commit] 仕様の行が増えました。図・モック（evidence/mock/）の更新が要らないか確かめてください（00_ルール/開発フロー.md）"
    break
  fi
done
exit 0
