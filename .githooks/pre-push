#!/bin/sh
# main への直接 push を止める（事故防止・層2）。ブランチを切って PR で main に入れる。
# 有効化: git config core.hooksPath .githooks

while read local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master)
      echo "[pre-push] main への直接 push は禁止です。"
      echo "  → git switch -c feature/xxx で作業ブランチを作り、push して PR を出してください"
      exit 1
      ;;
  esac
done
exit 0
