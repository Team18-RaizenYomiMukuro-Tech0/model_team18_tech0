#!/bin/sh
# 使い捨て Python の入口（#557）: ファイルが無ければ絶対パスを示して止め、py_compile が通らなければ実行しない。
# 使い方: scripts/pyrun <file.py> [引数...]
f="$1"
if [ -z "$f" ]; then echo "使い方: scripts/pyrun <file.py> [引数...]" >&2; exit 2; fi
case "$f" in /*) abs="$f" ;; *) abs="$PWD/$f" ;; esac
if [ ! -f "$f" ]; then echo "ファイルがありません: $abs" >&2; exit 2; fi
py=
for p in python3 python py; do if "$p" -c "import sys" >/dev/null 2>&1; then py="$p"; break; fi; done
if [ -z "$py" ]; then echo "python が見つかりません" >&2; exit 2; fi
if ! "$py" -c "import sys; compile(open(sys.argv[1], 'rb').read(), sys.argv[1], 'exec')" "$f"; then
  echo "py_compile（文法の確認）が通りません。実行しません: $abs" >&2; exit 2
fi
shift
exec "$py" "$f" "$@"
