<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 雛形。&lt;REPO&gt; をこのリポジトリの絶対パスに置換して ~/Library/LaunchAgents/com.munder.digest.plist へ置く（手順: 01_ナレッジ/定期実行の導入手順.md） -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.munder.digest</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>&lt;REPO&gt;/scripts/scheduled/run-digest.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>&lt;REPO&gt;</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/com.munder.digest.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/com.munder.digest.err</string>
</dict>
</plist>
