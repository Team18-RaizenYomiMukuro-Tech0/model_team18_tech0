# .env.example — このファイルを .env という名前でコピーし、値を入れる
# .env は Git に入れない（.gitignore に書いてある）
# 変数名は設計.md N-04 の案（GIFTIA_DB_*）

# 班の DB（MySQL Workbench に入れたものと同じ）
GIFTIA_DB_HOST=
GIFTIA_DB_PORT=3306
GIFTIA_DB_USER=
GIFTIA_DB_PASSWORD=

# この API を呼んでよい画面の URL（Next.js の開発サーバー）
CORS_ORIGINS=http://localhost:3000
