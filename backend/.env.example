# .env.example — このファイルを .env という名前でコピーし、値を入れる
# .env は Git に入れない（.gitignore に書いてある）
# 変数名は設計.md N-04 の案（GIFTIA_DB_*）

# 班の DB（MySQL Workbench に入れたものと同じ）
GIFTIA_DB_HOST=
GIFTIA_DB_PORT=3306
GIFTIA_DB_USER=
GIFTIA_DB_PASSWORD=

# この API を呼んでよい画面の送信元を 1 つだけ（公開した画面の https://〜.azurewebsites.net）。
# 空なら、どこからの通信も許さない。手元の開発では空のまま（画面が rewrites で同じ送信元から呼ぶ）
GIFTIA_ALLOWED_ORIGIN=
